# Local Docker Compose + host-side Next.js development values.
# Safe to commit: these credentials are for localhost only.

# Sibling AI repository (relative to this compose file)
VIDEO_ANALYTICS_CONTEXT=../video_analytics
FRUIT_PIPELINE_CONTEXT=../fruit-pipeline

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tarebar
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tarebar
POSTGRES_PORT=5432
APP_DATABASE_URL=postgresql://postgres:postgres@db:5432/tarebar
ANALYTICS_DATABASE_URL=postgresql://postgres:postgres@db:5432/tarebar

# --- Auth / public URLs ------------------------------------------------------
AUTH_SECRET=local-dev-auth-secret-change-me
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_PORT=3000

NEXT_PUBLIC_VIDEO_ANALYTICS_API_URL=http://localhost:8000
VIDEO_ANALYTICS_API_URL=http://localhost:8000
VIDEO_ANALYTICS_PORT=8000
VIDEO_ANALYTICS_INTERNAL_API_URL=http://video-analytics:8000
NEXT_PUBLIC_FRUIT_PIPELINE_API_URL=http://localhost:8010
FRUIT_PIPELINE_PORT=8010
FRUIT_PIPELINE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRUIT_PIPELINE_JOB_WORKERS=1
FRUIT_PIPELINE_MAX_UPLOAD_BYTES=1073741824
FRUIT_PIPELINE_DEVICE=cpu

# --- MediaMTX (localhost; set LAN IP for phone / other-device access) --------
NEXT_PUBLIC_MEDIAMTX_WEBRTC_URL=http://localhost:8889
NEXT_PUBLIC_MEDIAMTX_HLS_URL=http://localhost:8888
MEDIAMTX_WEBRTC_HOST=localhost
MEDIAMTX_INTERNAL_RTSP_URL=rtsp://mediamtx:8554
MEDIAMTX_INTERNAL_API_URL=http://mediamtx:9997

# --- Analytics ---------------------------------------------------------------
ANALYTICS_READ_KEY=local-read-key-change-me
ANALYTICS_INGEST_KEY=local-ingest-key-change-me
VIDEO_ANALYTICS_INGEST_URL=http://127.0.0.1:8000/api/v1/ingest/minutes
ANALYTICS_OUTBOX_DIR=/app/output/outbox
ANALYTICS_EXPECTED_SAMPLES_PER_MINUTE=30
ANALYTICS_PUBLISH_INTERVAL_SECONDS=10
ANALYTICS_ROLLUP_INTERVAL_SECONDS=15
ANALYTICS_TIMEZONE=Asia/Tehran

VIDEO_ANALYTICS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
VIDEO_ANALYTICS_JOB_WORKERS=2
VIDEO_ANALYTICS_PROCESSING_WIDTH=1280
VIDEO_ANALYTICS_FRAME_STRIDE=10
VIDEO_ANALYTICS_MAX_UPLOAD_BYTES=1073741824
VIDEO_ANALYTICS_LOG_LEVEL=INFO

VIDEO_ANALYTICS_FLEET_ENABLED=true
VIDEO_ANALYTICS_FLEET_FPS=0.5
VIDEO_ANALYTICS_FLEET_MAX_CAMERAS=32
VIDEO_ANALYTICS_FLEET_REFRESH_SECONDS=30
VIDEO_ANALYTICS_TRACKER=stabletrack
VIDEO_ANALYTICS_SPATIAL_PUBLISH_SECONDS=30
