generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  ORG_ADMIN
  FIELD_MANAGER
  MARKET_MANAGER
}

enum CameraStatus {
  ONLINE
  OFFLINE
  UNKNOWN
}

enum ScopeType {
  FIELD
  MARKET
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  IMPORT
  EXPORT
}

enum RegionType {
  RESTRICTED_AREA
  QUEUE
}

// Where an analysis result came from: a live camera stream or an uploaded file.
enum AnalysisSource {
  LIVE
  UPLOAD
}

// ─── Auth.js required models ─────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Domain models ───────────────────────────────────────────────────────────

model User {
  id        String    @id @default(cuid())
  username  String    @unique
  name      String
  email     String?   @unique
  password  String?
  role      Role      @default(MARKET_MANAGER)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  accounts Account[]
  sessions Session[]
  scopes   UserScope[]
}

model UserScope {
  id        String    @id @default(cuid())
  userId    String
  scopeType ScopeType
  fieldId   String?
  marketId  String?
  createdAt DateTime  @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  field  Field?  @relation(fields: [fieldId], references: [id])
  market Market? @relation(fields: [marketId], references: [id])

  @@unique([userId, scopeType, fieldId, marketId])
}

model Field {
  id        String    @id @default(cuid())
  name      String
  address   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  markets Market[]
  cameras Camera[]
  scopes  UserScope[]

  qualityAssessments FruitQualityAssessment[]
  incidentChecks     IncidentCheck[]
  measurementRuns    FruitMeasurementRun[]
}

model Market {
  id        String    @id @default(cuid())
  name      String
  address   String?
  fieldId   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  field   Field       @relation(fields: [fieldId], references: [id])
  booths  Booth[]
  cameras Camera[]
  scopes  UserScope[]
  regions Region[]

  qualityAssessments FruitQualityAssessment[]
  incidentChecks     IncidentCheck[]
  measurementRuns    FruitMeasurementRun[]
}

model BoothCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  booths Booth[]
}

model Booth {
  id         String    @id @default(cuid())
  number     String
  marketId   String
  categoryId String
  ownerId    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  market   Market        @relation(fields: [marketId], references: [id])
  category BoothCategory @relation(fields: [categoryId], references: [id])
  cameras  Camera[]
  regions  RegionBooth[]

  qualityAssessments FruitQualityAssessment[]
  incidentChecks     IncidentCheck[]
  measurementRuns    FruitMeasurementRun[]

  @@unique([marketId, number])
}

model Camera {
  id        String       @id @default(cuid())
  name      String
  streamUrl String?
  status    CameraStatus @default(UNKNOWN)
  fieldId   String?
  marketId  String?
  boothId   String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  // Last known frame, captured client-side while the live stream is healthy.
  // Lets the region polygon editor show a reference image when the live feed
  // (often a phone-based RTMP push) is temporarily unreachable.
  snapshotDataUrl   String?   @db.Text
  snapshotUpdatedAt DateTime?

  field  Field?  @relation(fields: [fieldId], references: [id])
  market Market? @relation(fields: [marketId], references: [id])
  booth  Booth?  @relation(fields: [boothId], references: [id])

  regions      CameraRegion[]
  calibrations CameraCalibration[]

  qualityAssessments FruitQualityAssessment[]
  incidentChecks     IncidentCheck[]
  measurementRuns    FruitMeasurementRun[]
}

model CameraCalibration {
  id                   String   @id @default(cuid())
  cameraId             String
  serviceJobId         String   @unique
  cameraGroup          String?
  boardType            String
  columns              Int
  rows                 Int
  squareSizeMm         Float
  markerSizeMm         Float?
  dictionary           String?
  resolutionWidth      Int
  resolutionHeight     Int
  reprojectionError    Float
  maxReprojectionError Float
  calibrationPath      String
  parameters           Json
  createdAt            DateTime @default(now())

  camera Camera @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@index([cameraId, createdAt])
}

// ─── Region Management ──────────────────────────────────────────────────────
//
// A Region is a user-defined spatial area inside a Market. It is intentionally
// geometry-free: the same logical Region can be seen by many cameras, and each
// camera stores its OWN polygon for the portion it sees (see CameraRegion).
//
//   Region ──< CameraRegion >── Camera     (M:N, geometry lives on the edge)
//   Region ──< RegionBooth   >── Booth      (M:N, "Stall mapping")
//
// "Stall" in the product spec maps to the existing Booth entity.

model Region {
  id          String     @id @default(cuid())
  name        String
  description String?
  marketId    String
  color       String? // optional UI hint, e.g. "#22c55e"
  type        RegionType @default(RESTRICTED_AREA)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  market        Market         @relation(fields: [marketId], references: [id])
  cameraRegions CameraRegion[]
  booths        RegionBooth[]

  // The same name may be reused for a different analytic purpose in one market.
  // Case-insensitive uniqueness per (market, type) is enforced in the service layer.
  @@unique([marketId, name, type])
  @@index([marketId])
}

// The Camera <-> Region edge. Owns the geometry for how a single camera sees a
// single region. EffectiveArea = mainPolygon - exclusionPolygons.
//
// Coordinates are normalized floats in [0,1] relative to the camera frame
// (resolution-independent). Shapes:
//   mainPolygon        : Json  -> Point[]      e.g. [{ "x": 0.1, "y": 0.2 }, ...]
//   exclusionPolygons  : Json  -> Point[][]    e.g. [[ {x,y}, ... ], ...]
model CameraRegion {
  id                String    @id @default(cuid())
  cameraId          String
  regionId          String
  mainPolygon       Json
  exclusionPolygons Json      @default("[]")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  camera Camera @relation(fields: [cameraId], references: [id])
  region Region @relation(fields: [regionId], references: [id])

  // One mapping per (camera, region) pair.
  @@unique([cameraId, regionId])
  @@index([regionId])
  @@index([cameraId])
}

// The Region <-> Booth (Stall) edge. Pure association; business users decide it.
model RegionBooth {
  id        String    @id @default(cuid())
  regionId  String
  boothId   String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  region Region @relation(fields: [regionId], references: [id])
  booth  Booth  @relation(fields: [boothId], references: [id])

  @@unique([regionId, boothId])
  @@index([regionId])
  @@index([boothId])
}

// Generic, append-only audit trail for sensitive mutations.
model AuditLog {
  id         String      @id @default(cuid())
  actorId    String? // User.id (nullable: keep history if user removed)
  actorName  String?
  action     AuditAction
  entityType String // "Region" | "CameraRegion" | "RegionBooth"
  entityId   String
  marketId   String? // denormalized for scope-filtered audit queries
  metadata   Json? // before/after snapshot or diff
  createdAt  DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([marketId])
  @@index([createdAt])
}

// ─── Analysis records ───────────────────────────────────────────────────────
//
// Results of the AI services are stored here so they can be exported, scoped by
// location and aggregated into the executive report. The three location ids are
// denormalised at write time (booth → market → field), which keeps report
// queries to a single indexed lookup per level.

// One visual freshness assessment (Qwen2.5-VL) of a fruit image, video or stream.
model FruitQualityAssessment {
  id                 String         @id @default(cuid())
  source             AnalysisSource
  cameraId           String?
  fieldId            String?
  marketId           String?
  boothId            String?
  fileName           String?
  hasFruit           Boolean
  label              String // Persian label returned by the model, e.g. "تازه"
  grade              String? // A | B | C | D, derived from the score
  freshnessScore     Int
  confidence         Int
  freshPercent       Int
  middlePercent      Int
  rottenPercent      Int
  fruitCountEstimate Int?
  summaryFa          String         @db.Text
  recommendationFa   String?        @db.Text
  detailLevel        String         @default("summary")
  details            Json // fruit types, defects, per-frame scores, statistics, advice
  thumbnails         Json? // small JPEG data URLs kept as report evidence
  frameCount         Int
  inferenceSeconds   Float
  modelName          String?
  createdById        String?
  createdByName      String?
  createdAt          DateTime       @default(now())

  camera Camera? @relation(fields: [cameraId], references: [id], onDelete: SetNull)
  field  Field?  @relation(fields: [fieldId], references: [id], onDelete: SetNull)
  market Market? @relation(fields: [marketId], references: [id], onDelete: SetNull)
  booth  Booth?  @relation(fields: [boothId], references: [id], onDelete: SetNull)

  @@index([fieldId, createdAt])
  @@index([marketId, createdAt])
  @@index([boothId, createdAt])
  @@index([cameraId, createdAt])
  @@index([createdAt])
}

// One incident-detection window: are people fighting, is the floor clean.
model IncidentCheck {
  id               String         @id @default(cuid())
  source           AnalysisSource
  cameraId         String?
  fieldId          String?
  marketId         String?
  boothId          String?
  fileName         String?
  fighting         Boolean
  floorClean       Boolean
  windowLabel      String? // e.g. "00:10–00:20" for a recorded video
  windowSeconds    Float?
  frameCount       Int
  inferenceSeconds Float
  thumbnail        String?        @db.Text // evidence frame, stored for alerts only
  modelName        String?
  createdById      String?
  createdByName    String?
  createdAt        DateTime       @default(now())

  camera Camera? @relation(fields: [cameraId], references: [id], onDelete: SetNull)
  field  Field?  @relation(fields: [fieldId], references: [id], onDelete: SetNull)
  market Market? @relation(fields: [marketId], references: [id], onDelete: SetNull)
  booth  Booth?  @relation(fields: [boothId], references: [id], onDelete: SetNull)

  @@index([fieldId, createdAt])
  @@index([marketId, createdAt])
  @@index([boothId, createdAt])
  @@index([cameraId, createdAt])
  @@index([createdAt])
}

// Summary of one completed fruit counting and sizing job of the fruit pipeline.
model FruitMeasurementRun {
  id                     String         @id @default(cuid())
  source                 AnalysisSource
  cameraId               String?
  fieldId                String?
  marketId               String?
  boothId                String?
  serviceJobId           String         @unique
  processingMode         String?
  palletType             String?
  processedFrames        Int
  totalFruitObservations Int
  lastFruitCount         Int?
  avgWidthMm             Float?
  avgLengthMm            Float?
  avgDiameterMm          Float?
  sizeStatistics         Json?
  createdById            String?
  createdByName          String?
  createdAt              DateTime       @default(now())

  camera Camera? @relation(fields: [cameraId], references: [id], onDelete: SetNull)
  field  Field?  @relation(fields: [fieldId], references: [id], onDelete: SetNull)
  market Market? @relation(fields: [marketId], references: [id], onDelete: SetNull)
  booth  Booth?  @relation(fields: [boothId], references: [id], onDelete: SetNull)

  @@index([fieldId, createdAt])
  @@index([marketId, createdAt])
  @@index([boothId, createdAt])
  @@index([cameraId, createdAt])
  @@index([createdAt])
}
