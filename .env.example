# Database — keep DATABASE_URL identical in .env and .env.local
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tarebar"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-strong-random-secret"

# Base URL of the running app (no trailing slash)
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Recorded-video analytics service (video_analytics_mvp FastAPI)
NEXT_PUBLIC_VIDEO_ANALYTICS_API_URL="http://localhost:8000"

# MediaMTX browser endpoints. Use the Docker host's LAN IP when opening the
# dashboard from another device (for example http://192.168.1.20:8889).
NEXT_PUBLIC_MEDIAMTX_WEBRTC_URL="http://localhost:8889"
NEXT_PUBLIC_MEDIAMTX_HLS_URL="http://localhost:8888"

# Host/IP advertised as a WebRTC ICE candidate. Set this to the server LAN IP
# for phone/LAN access, or a public DNS name when deployed behind NAT.
MEDIAMTX_WEBRTC_HOST="localhost"

# Server-side URL for local development. Docker Compose overrides this with the
# internal `video-analytics` service name.
VIDEO_ANALYTICS_API_URL="http://localhost:8000"
ANALYTICS_READ_KEY="replace-with-the-video-analytics-read-key"

# Fleet/general dashboard tracker (not on-demand jobs).
# Allowed: bytetrack, stabletrack, deepocsort, botsort
VIDEO_ANALYTICS_TRACKER=stabletrack
