# Development image: install deps once, then bind-mount source for hot reload.
FROM node:20-alpine

WORKDIR /app

RUN apk add --no-cache libc6-compat openssl

COPY package.json package-lock.json ./
COPY prisma ./prisma
RUN npm ci && npx prisma generate

EXPOSE 3000

ENV NODE_ENV=development \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000 \
    WATCHPACK_POLLING=true \
    CHOKIDAR_USEPOLLING=true

CMD ["sh", "-c", "npx prisma migrate deploy && npx prisma generate && npm run dev -- --hostname 0.0.0.0 --port 3000"]
